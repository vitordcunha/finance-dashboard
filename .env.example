# Supabase (Vite)
# URL do projeto + Publishable key (Settings → API Keys)
# A aba "Legacy" ainda tem anon/service_role; prefira publishable.
# Em produção (Vercel): mesmas vars no dashboard — ver docs/DEPLOY.md
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional — username do bot (sem @) para deep link em Configurações → Telegram
# VITE_TELEGRAM_BOT_USERNAME=seu_bot

# Opcional (legacy) — só se ainda usar a aba Legacy anon key
# VITE_SUPABASE_ANON_KEY=eyJ...
